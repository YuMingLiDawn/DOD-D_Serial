{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: configure (debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/debug",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "cmake: build (debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/debug",
        "--config",
        "Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "cmake: configure (debug)",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "cmake: run (debug)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/debug",
        "--config",
        "Debug",
        "--target",
        "run"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "cmake: build (debug)",
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "cmake: configure (release)",
      "type": "process",
      "command": "cmake",
      "args": [
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/release",
        "-DCMAKE_BUILD_TYPE=Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "cmake: build (release)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/release",
        "--config",
        "Release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "cmake: configure (release)",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "打包 Release（一键 zip）",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/release",
        "--config",
        "Release",
        "--target",
        "create-package"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "cmake: build (release)",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": ["$gcc", "$msCompile"],
      "detail": "configure+构建 Release → 部署 Qt 运行库（Windows 用 windeployqt）→ 生成 build/release/DOD-D_Serial-<版本>-<平台>-<架构>.zip"
    },
    {
      "label": "cmake: distclean",
      "type": "process",
      "command": "cmake",
      "args": ["-E", "remove_directory", "${workspaceFolder}/build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
