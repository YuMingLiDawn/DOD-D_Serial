{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 DOD-D_Serial (Linux / gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.launchTargetDirectory}",
      "stopAtEntry": false,
      "externalConsole": false,
      "environment": [
        { "name": "DOD_ULXD_HOST", "value": "192.168.3.123" },
        { "name": "DOD_ULXD_FREQ", "value": "630000" },
        { "name": "DOD_ULXD_CHANNEL", "value": "1" }
      ],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "启用 gdb pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "反汇编使用 Intel 语法",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cmake: build (debug)"
    },
    {
      "name": "调试 DOD-D_Serial (macOS / lldb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.launchTargetDirectory}",
      "stopAtEntry": false,
      "externalConsole": false,
      "environment": [
        { "name": "DOD_ULXD_HOST", "value": "192.168.3.123" },
        { "name": "DOD_ULXD_FREQ", "value": "630000" },
        { "name": "DOD_ULXD_CHANNEL", "value": "1" }
      ],
      "MIMode": "lldb",
      "preLaunchTask": "cmake: build (debug)"
    },
    {
      "name": "调试 DOD-D_Serial (Windows / MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "cwd": "${command:cmake.launchTargetDirectory}",
      "console": "integratedTerminal",
      "env": {
        "DOD_ULXD_HOST": "192.168.3.123",
        "DOD_ULXD_FREQ": "630000",
        "DOD_ULXD_CHANNEL": "1"
      },
      "preLaunchTask": "cmake: build (debug)"
    }
  ]
}
